# Application (client) id of the single app registration (same value as VITE_CLIENT_ID)
API_CLIENT_ID=00000000-0000-0000-0000-000000000000
# restricted = only approved tenants; open = any Entra tenant is auto-approved
AUTH_MODE=restricted
# tenantId=Name, comma separated; created as approved organizations at start-up
SEED_TENANTS=11111111-1111-1111-1111-111111111111=Technorucs,22222222-2222-2222-2222-222222222222=Mindgate
# tenantId:objectId of the first SuperAdmin(s)
BOOTSTRAP_ADMINS=11111111-1111-1111-1111-111111111111:aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa
# pending = guests (self-signed-up Gmail users etc.) wait for an admin; allow = straight in as Employee
GUEST_POLICY=pending
# Invite Gmail guests automatically (optional). Needs the app's Graph permission User.Invite.All with admin consent.
# TENANT_ID=00000000-0000-0000-0000-000000000000
# INVITE_CLIENT_SECRET=
# WEB_URL=http://localhost:5174
# INVITE_DOMAINS=gmail.com,googlemail.com
# INVITES_PER_HOUR=30
CORS_ORIGIN=http://localhost:5174
DATA_FILE=./data.json
PORT=3001
