# Application (client) id of the SPA app registration
VITE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Application (client) id of the API app registration (the scope is api://<id>/access_as_user)
VITE_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
# "common" lets work, school, personal and federated (Google) accounts reach the sign-in page
VITE_AUTHORITY=https://login.microsoftonline.com/common
VITE_API_URL=http://localhost:3001
