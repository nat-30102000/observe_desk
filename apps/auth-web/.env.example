# Application (client) id of the single app registration (scope: api://<id>/access_as_user)
VITE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# "common" lets work, school, personal and federated (Google) accounts reach the sign-in page
VITE_AUTHORITY=https://login.microsoftonline.com/common
# Your tenant id. When set, a second "Continue with Gmail" button signs in through your tenant (needed for Google sign-up)
VITE_TENANT_ID=
VITE_API_URL=http://localhost:3001
